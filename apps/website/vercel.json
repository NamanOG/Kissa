{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": { "deploymentEnabled": { "main": false } },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "kissa-player.vercel.app" }],
      "destination": "https://kissa.glyphcode.studio/$1",
      "permanent": true
    }
  ]
}
