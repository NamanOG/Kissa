{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run website:build",
  "outputDirectory": "apps/website/dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "kissa-player.vercel.app" }],
      "destination": "https://kissa.glyphcode.studio/$1",
      "permanent": true
    }
  ]
}
